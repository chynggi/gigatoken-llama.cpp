# syntax=docker/dockerfile:1

# ------------------------------------------------------------
# Stage 1: Build gigatoken-llama.cpp for RTX 5090 / Blackwell
# ------------------------------------------------------------
FROM nvidia/cuda:12.9.2-devel-ubuntu24.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    ninja-build \
    git \
    ca-certificates \
    curl \
    libcurl4-openssl-dev \
    libssl-dev \
    ccache \
    && rm -rf /var/lib/apt/lists/*

# Node.js for the WebUI (tools/ui) npm build. Vite 7 needs Node >=20.19,
# newer than the Node 18 that Ubuntu 24.04's apt repo ships.
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

# froggeric/Qwen-Fixed-Chat-Templates (v22.1, Apache-2.0): drop-in Jinja
# chat template for Qwen 3.5/3.6/3.8 that fixes rendering errors, KV cache
# invalidation and agentic stalling of the official Qwen templates.
# Only consumed by the runtime-qwen target; the stock runtime stays clean.
RUN curl -fsSL \
    https://huggingface.co/froggeric/Qwen-Fixed-Chat-Templates/resolve/main/chat_template.jinja \
    -o /opt/qwen-chat-template.jinja

# Google Gemma 4 canonical chat template (2026-07-09, Gemma license):
# fixes tool-calling loops, turn closures and thinking content-ordering.
# GGUF conversions often carry an older template, so ship the latest one.
# Only consumed by the runtime-gemma target.
RUN curl -fsSL \
    https://huggingface.co/google/gemma-4-31B-it/resolve/main/chat_template.jinja \
    -o /opt/gemma-chat-template.jinja

WORKDIR /src

COPY . .

# The devel image only ships the CUDA driver stub (no real libcuda.so.1,
# that comes from the host driver at container runtime). ggml-cuda links
# against it fine, but ninja then fails linking the CLI tools/server with
# "undefined reference to cuMemCreate/cuGetErrorString/..." because ld
# can't locate libcuda.so.1 to verify those symbols transitively.
# Give the stub the SONAME ld looks for and put it on the link-time search
# path so every target resolves it, not just ggml-cuda itself.
RUN ln -s /usr/local/cuda/lib64/stubs/libcuda.so /usr/local/cuda/lib64/stubs/libcuda.so.1
ENV LD_LIBRARY_PATH=/usr/local/cuda/lib64/stubs

# ccache cache mount survives between builds, so only changed sources
# recompile. Same for the npm cache used by the UI build below.
RUN --mount=type=cache,target=/root/.ccache \
    --mount=type=cache,target=/root/.npm \
    cmake -S . -B build \
    -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DGGML_CUDA=ON \
    -DGGML_CUDA_FA=ON \
    -DGGML_CUDA_FA_ALL_QUANTS=ON \
    -DCMAKE_CUDA_ARCHITECTURES=120 \
    -DLLAMA_BUILD_TESTS=OFF \
    -DLLAMA_BUILD_EXAMPLES=OFF \
    -DLLAMA_BUILD_UI=ON \
    -DLLAMA_USE_PREBUILT_UI=OFF \
    -DCMAKE_C_COMPILER_LAUNCHER=ccache \
    -DCMAKE_CXX_COMPILER_LAUNCHER=ccache \
    -DCMAKE_CUDA_COMPILER_LAUNCHER=ccache \
    && cmake --build build -j 6

# ------------------------------------------------------------
# Stage 1.5: CUDA runtime libraries
# Provides libcuda.so.1 and CUDA runtime for linking
# ------------------------------------------------------------
FROM nvidia/cuda:12.9.2-runtime-ubuntu24.04 AS runtime-libs

# No additional setup needed; this stage just exports the runtime libs

# ------------------------------------------------------------
# Stage 2: Shared runtime image
# Vast.ai runtime + compiled binaries + CUDA libs.
# Both final images below derive from this.
# ------------------------------------------------------------
FROM vastai/llama-cpp:b10435-cuda-12.9 AS runtime-base

USER root

# Copy CUDA runtime libraries from official CUDA runtime image
# to ensure libcuda.so.1 and friends are available
COPY --from=runtime-libs /usr/local/cuda/lib64/ /usr/local/cuda/lib64/

# Replace Vast's llama.cpp distribution with the fork build.
#
# Keep the same directory because Vast already exports:
#   LLAMA_CPP_DIR=/opt/llama.cpp/cuda-12.8
#   PATH=/opt/llama.cpp/cuda-12.8:$PATH
#
COPY --from=builder /src/build/bin/ /opt/llama.cpp/cuda-12.8/

# Useful metadata so it is obvious this is not stock Vast llama.cpp.
ENV LLAMA_CPP_RELEASE=gigatoken
ENV LLAMA_CPP_DIR=/opt/llama.cpp/cuda-12.8
ENV LD_LIBRARY_PATH=/usr/local/cuda/lib64

# Do NOT override ENTRYPOINT.
# Inherited:
# ENTRYPOINT ["/opt/instance-tools/bin/entrypoint.sh"]

# ------------------------------------------------------------
# Stage 3a: Runtime with the fixed Qwen chat template
# froggeric/Qwen-Fixed-Chat-Templates (v22.1, Apache-2.0).
# Build with: docker build --target runtime-qwen -t <tag> .
# llama-server picks it up via LLAMA_ARG_CHAT_TEMPLATE_FILE;
# pass --reasoning-format deepseek to extract <think> blocks into
# the reasoning_content API field.
# ------------------------------------------------------------
FROM runtime-base AS runtime-qwen

COPY --from=builder /opt/qwen-chat-template.jinja /opt/llama.cpp/cuda-12.8/chat_template.jinja
ENV LLAMA_ARG_CHAT_TEMPLATE_FILE=/opt/llama.cpp/cuda-12.8/chat_template.jinja

# ------------------------------------------------------------
# Stage 3b: Runtime with the canonical Gemma 4 chat template
# Google gemma-4-31B-it (2026-07-09).
# Build with: docker build --target runtime-gemma -t <tag> .
# ------------------------------------------------------------
FROM runtime-base AS runtime-gemma

COPY --from=builder /opt/gemma-chat-template.jinja /opt/llama.cpp/cuda-12.8/chat_template.jinja
ENV LLAMA_ARG_CHAT_TEMPLATE_FILE=/opt/llama.cpp/cuda-12.8/chat_template.jinja

# ------------------------------------------------------------
# Stage 3c: Stock runtime (no chat template override)
# Default build target; keep this the last stage.
# ------------------------------------------------------------
FROM runtime-base AS runtime
