+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::borrow::Cow;
+
+    #[test]
+    fn normalizes_invalid_utf8_like_llama_cpp() {
+        let valid = b"valid \xf0\x9f\xa6\x99";
+        assert!(matches!(normalize_llama_bpe_input(valid), Cow::Borrowed(_)));
+        assert_eq!(
+            normalize_llama_bpe_input(b"\xf0\x28\x8c\x28\xff").as_ref(),
+            b"\xef\xbf\xbd\x28\xef\xbf\xbd\x28\xef\xbf\xbd",
+        );
+        assert_eq!(
+            normalize_llama_bpe_input(b"\xe2\x82").as_ref(),
+            b"\xef\xbf\xbd\xef\xbf\xbd"
+        );
+        assert_eq!(normalize_llama_bpe_input(b"\xc0\x80").as_ref(), b"\0");
+    }
+
+    #[test]
+    fn panic_is_caught_at_the_boundary() {
+        let mut error = GtLlamaError::default();
+        let status = ffi_call(&mut error, || -> Result<(), FfiError> {
+            panic!("caught panic")
+        });
+        assert_eq!(status, GT_LLAMA_STATUS_PANIC);
+        let text = unsafe { std::slice::from_raw_parts(error.data, error.len) };
+        assert_eq!(text, b"caught panic");
+        unsafe { gt_llama_error_free(&mut error) };
+    }
+}
