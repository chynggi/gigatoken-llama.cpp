+    /// Encode text that has already gone through the caller's SentencePiece
+    /// whitespace normalization. Invalid UTF-8 bytes are emitted through the
+    /// model's byte-fallback tokens; valid input stays on the cached fast path.
+    pub fn encode_normalized_bytes_with(
+        &self,
+        state: &mut EncodeState,
+        input: &[u8],
+        out: &mut Vec<TokenId>,
+    ) -> Result<(), u8> {
+        if let Ok(text) = std::str::from_utf8(input) {
+            self.encode_normalized_cb(state, text, &mut |tokens| out.extend_from_slice(tokens));
+            return Ok(());
+        }
+
+        let mut valid_start = 0;
+        let mut offset = 0;
+        while offset < input.len() {
+            let width = match input[offset] >> 4 {
+                0..=11 => 1,
+                12..=13 => 2,
+                14 => 3,
+                _ => 4,
+            }
+            .min(input.len() - offset);
+            let end = offset + width;
+            if std::str::from_utf8(&input[offset..end]).is_err() {
+                if valid_start != offset {
+                    // SAFETY: each symbol in this range was validated above.
+                    let text =
+                        unsafe { std::str::from_utf8_unchecked(&input[valid_start..offset]) };
+                    self.encode_normalized_cb(state, text, &mut |tokens| {
+                        out.extend_from_slice(tokens)
+                    });
+                }
+                for &byte in &input[offset..end] {
+                    let Some(id) = self.byte_fallback_ids[byte as usize] else {
+                        return Err(byte);
+                    };
+                    out.push(id);
+                }
+                valid_start = end;
+            }
+            offset = end;
+        }
+        if valid_start != input.len() {
+            // SAFETY: each symbol in this range was validated above.
+            let text = unsafe { std::str::from_utf8_unchecked(&input[valid_start..]) };
+            self.encode_normalized_cb(state, text, &mut |tokens| out.extend_from_slice(tokens));
+        }
+        Ok(())
+    }
+
