@@ -0,0 +1,278 @@
+#![cfg(feature = "llama-cpp")]
+
+use gigatoken_rs::llama_cpp::*;
+use std::ptr;
+
+fn byte_to_unicode() -> [char; 256] {
+    let allowed: Vec<u8> = (33..=126).chain(161..=172).chain(174..=255).collect();
+    let mut table = ['\0'; 256];
+    for &b in &allowed {
+        table[b as usize] = b as char;
+    }
+    let mut extra = 0u32;
+    for b in 0..=255u8 {
+        if table[b as usize] == '\0' {
+            table[b as usize] = char::from_u32(256 + extra).unwrap();
+            extra += 1;
+        }
+    }
+    table
+}
+
+struct VocabFixture {
+    storage: Vec<Vec<u8>>,
+    entries: Vec<GtLlamaVocabToken>,
+}
+
+impl VocabFixture {
+    fn bpe(extra: &[&[u8]]) -> Self {
+        let byte_chars = byte_to_unicode();
+        let mut storage: Vec<Vec<u8>> = byte_chars
+            .iter()
+            .map(|ch| ch.to_string().into_bytes())
+            .collect();
+        storage.extend(extra.iter().map(|piece| piece.to_vec()));
+        let entries = storage
+            .iter()
+            .map(|piece| GtLlamaVocabToken {
+                text: GtLlamaBytes::from_slice(piece),
+                score: 0.0,
+                token_type: GT_LLAMA_TOKEN_TYPE_NORMAL,
+            })
+            .collect();
+        Self { storage, entries }
+    }
+
+    fn spm(extra: &[(&[u8], f32)]) -> Self {
+        let mut storage: Vec<Vec<u8>> = (0..=255u8)
+            .map(|b| format!("<0x{b:02X}>").into_bytes())
+            .collect();
+        storage.extend(extra.iter().map(|(piece, _)| piece.to_vec()));
+        let mut entries: Vec<GtLlamaVocabToken> = storage
+            .iter()
+            .take(256)
+            .map(|piece| GtLlamaVocabToken {
+                text: GtLlamaBytes::from_slice(piece),
+                score: 0.0,
+                token_type: GT_LLAMA_TOKEN_TYPE_BYTE,
+            })
+            .collect();
+        entries.extend(
+            storage
+                .iter()
+                .skip(256)
+                .zip(extra)
+                .map(|(piece, (_, score))| GtLlamaVocabToken {
+                    text: GtLlamaBytes::from_slice(piece),
+                    score: *score,
+                    token_type: GT_LLAMA_TOKEN_TYPE_NORMAL,
+                }),
+        );
+        Self { storage, entries }
+    }
+
+    fn as_slice(&self) -> &[GtLlamaVocabToken] {
+        let _ = &self.storage;
+        &self.entries
+    }
+}
+
+unsafe fn take_error(mut error: GtLlamaError) -> String {
+    let text = if error.data.is_null() {
+        String::new()
+    } else {
+        String::from_utf8_lossy(unsafe { std::slice::from_raw_parts(error.data, error.len) })
+            .into_owned()
+    };
+    unsafe { gt_llama_error_free(&mut error) };
+    text
+}
+
+unsafe fn encode(handle: *mut GtLlamaTokenizer, input: &[u8]) -> Result<Vec<u32>, String> {
+    let mut tokens = GtLlamaTokenBuffer::default();
+    let mut error = GtLlamaError::default();
+    let status = unsafe {
+        gt_llama_tokenizer_encode(
+            handle,
+            GtLlamaBytes::from_slice(input),
+            &mut tokens,
+            &mut error,
+        )
+    };
+    if status != GT_LLAMA_STATUS_OK {
+        return Err(unsafe { take_error(error) });
+    }
+    let result = unsafe { std::slice::from_raw_parts(tokens.data, tokens.len) }.to_vec();
+    unsafe { gt_llama_token_buffer_free(&mut tokens) };
+    Ok(result)
+}
+
+#[test]
+fn bpe_explicit_ranks_encode_and_own_the_result_buffer() {
+    let vocab = VocabFixture::bpe(&[b"ab", b"abc"]);
+    let merges = [
+        GtLlamaMerge {
+            left: b'a' as u32,
+            right: b'b' as u32,
+            merged: 256,
+            rank: 1,
+        },
+        GtLlamaMerge {
+            left: 256,
+            right: b'c' as u32,
+            merged: 257,
+            rank: 0,
+        },
+    ];
+    let mut handle = ptr::null_mut();
+    let mut error = GtLlamaError::default();
+    let status = unsafe {
+        gt_llama_tokenizer_create_bpe(
+            vocab.as_slice().as_ptr(),
+            vocab.as_slice().len(),
+            merges.as_ptr(),
+            merges.len(),
+            GT_LLAMA_PRETOKENIZER_GPT2,
+            0,
+            &mut handle,
+            &mut error,
+        )
+    };
+    assert_eq!(status, GT_LLAMA_STATUS_OK, "{}", unsafe {
+        take_error(error)
+    });
+    assert_eq!(unsafe { encode(handle, b"abc") }.unwrap(), vec![257]);
+    unsafe { gt_llama_tokenizer_free(handle) };
+}
+
+#[test]
+fn kimi_vocab_ranks_leave_special_partitioning_to_llama_cpp() {
+    let mut vocab = VocabFixture::bpe(&[b"ab", b"<special>"]);
+    vocab.entries[257].token_type = GT_LLAMA_TOKEN_TYPE_SPECIAL;
+    let mut handle = ptr::null_mut();
+    let mut error = GtLlamaError::default();
+    let status = unsafe {
+        gt_llama_tokenizer_create_bpe(
+            vocab.as_slice().as_ptr(),
+            vocab.as_slice().len(),
+            ptr::null(),
+            0,
+            GT_LLAMA_PRETOKENIZER_KIMI,
+            GT_LLAMA_BPE_FLAG_VOCAB_ID_RANKS,
+            &mut handle,
+            &mut error,
+        )
+    };
+    assert_eq!(status, GT_LLAMA_STATUS_OK, "{}", unsafe {
+        take_error(error)
+    });
+    assert_eq!(unsafe { encode(handle, b"ab") }.unwrap(), vec![256]);
+    assert_eq!(
+        unsafe { encode(handle, b"<special>") }.unwrap(),
+        b"<special>"
+            .iter()
+            .map(|&byte| byte as u32)
+            .collect::<Vec<_>>()
+    );
+    unsafe { gt_llama_tokenizer_free(handle) };
+}
+
+#[test]
+fn spm_recovers_score_ranked_merges_and_handles_invalid_utf8() {
+    let vocab = VocabFixture::spm(&[
+        (b"a", 0.0),
+        (b"b", 0.0),
+        (b"c", 0.0),
+        (b"ab", 1.0),
+        (b"abc", 2.0),
+    ]);
+    let mut handle = ptr::null_mut();
+    let mut error = GtLlamaError::default();
+    let status = unsafe {
+        gt_llama_tokenizer_create_spm(
+            vocab.as_slice().as_ptr(),
+            vocab.as_slice().len(),
+            ptr::null(),
+            0,
+            GT_LLAMA_SPM_MERGES_FROM_SCORES,
+            &mut handle,
+            &mut error,
+        )
+    };
+    assert_eq!(status, GT_LLAMA_STATUS_OK, "{}", unsafe {
+        take_error(error)
+    });
+    assert_eq!(unsafe { encode(handle, b"abc") }.unwrap(), vec![260]);
+    assert_eq!(unsafe { encode(handle, &[0xFF]) }.unwrap(), vec![255]);
+    assert_eq!(
+        unsafe { encode(handle, &[0xF0, b'a', b'b', b'c']) }.unwrap(),
+        vec![240, 97, 98, 99]
+    );
+    unsafe { gt_llama_tokenizer_free(handle) };
+}
+
+#[test]
+fn encode_uses_independent_workers_across_threads() {
+    let vocab = VocabFixture::bpe(&[b"ab"]);
+    let merges = [GtLlamaMerge {
+        left: b'a' as u32,
+        right: b'b' as u32,
+        merged: 256,
+        rank: 0,
+    }];
+    let mut handle = ptr::null_mut();
+    let mut error = GtLlamaError::default();
+    assert_eq!(
+        unsafe {
+            gt_llama_tokenizer_create_bpe(
+                vocab.as_slice().as_ptr(),
+                vocab.as_slice().len(),
+                merges.as_ptr(),
+                merges.len(),
+                GT_LLAMA_PRETOKENIZER_GPT2,
+                0,
+                &mut handle,
+                &mut error,
+            )
+        },
+        GT_LLAMA_STATUS_OK,
+        "{}",
+        unsafe { take_error(error) }
+    );
+    let shared = handle as usize;
+    let threads: Vec<_> = (0..8)
+        .map(|_| {
+            std::thread::spawn(move || {
+                for _ in 0..100 {
+                    assert_eq!(
+                        unsafe { encode(shared as *mut GtLlamaTokenizer, b"ab ab") }.unwrap(),
+                        vec![256, 32, 256]
+                    );
+                }
+            })
+        })
+        .collect();
+    for thread in threads {
+        thread.join().unwrap();
+    }
+    unsafe { gt_llama_tokenizer_free(handle) };
+}
+
+#[test]
+fn invalid_arguments_return_an_owned_error() {
+    let mut tokens = GtLlamaTokenBuffer::default();
+    let mut error = GtLlamaError::default();
+    let status = unsafe {
+        gt_llama_tokenizer_encode(
+            ptr::null_mut(),
+            GtLlamaBytes {
+                data: ptr::null(),
+                len: 1,
+            },
+            &mut tokens,
+            &mut error,
+        )
+    };
+    assert_eq!(status, GT_LLAMA_STATUS_INVALID_ARGUMENT);
+    assert!(unsafe { take_error(error) }.contains("tokenizer"));
+}
